{
  "name": "server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=../.env src/index.js",
    "start": "node --env-file=../.env src/index.js",
    "migrate": "node --env-file=../.env src/migrate.js",
